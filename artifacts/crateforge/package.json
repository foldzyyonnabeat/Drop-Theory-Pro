{
  "name": "@workspace/crateforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "dev:desktop": "node scripts/prepare-stem-runtime.mjs && vite --config vite.config.ts --mode desktop --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vite build --config vite.config.ts",
    "build:desktop": "node scripts/prepare-stem-runtime.mjs && vite build --config vite.config.ts --mode desktop",
    "bundle:windows:offline": "node scripts/build-offline-bundle.mjs",
    "bundle:windows:all-models": "node scripts/build-all-models-setup.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "desktop": "tauri",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:stems": "python -m unittest discover -s src-tauri/tests && python src-tauri/src/stem_runner_test.py && node --test src/lib/stem-model-download.test.cjs",
    "test:audio": "node --test src/lib/audio-mixer.test.cjs src/lib/deck-loop.test.cjs src/lib/midi-types.test.cjs src/lib/library-backup.test.cjs src/lib/desktop-imported-audio.test.cjs src/lib/browser-audio-persistence.test.cjs src/lib/set-planner.test.cjs src/lib/camelot.test.cjs src/lib/rekordbox-xml.test.cjs src/lib/analysis-locks.test.cjs src/workers/track-analysis.worker.test.cjs",
    "verify": "pnpm run typecheck && pnpm run test:audio && pnpm run test:stems && pnpm run build",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check-release": "node scripts/generate-third-party-notices.mjs --release",
    "drop-theory-pro": "node scripts/crateforge.mjs"
  },
